local FL=new("TextLabel",{Size=UDim2.new(0,90,0,24),Position=UDim2.new(0.5,-45,0,6),BackgroundColor3=Color3.new(0,0,0),BackgroundTransparency=0.35,BorderSizePixel=0,Text="FPS: --",TextColor3=Color3.fromRGB(0,220,0),TextSize=13,Font=Enum.Font.GothamBold,Visible=false},Root)
corner(FL,6)
local frames,acc=0,0

RunService:BindToRenderStep("KH_Main",Enum.RenderPriority.Camera.Value+1,function(dt)
 refresh()
 pcall(doAim)
 pcall(updateESP)
 local vs=Cam.ViewportSize
 if fovCircle then fovCircle.Position=vs/2 fovCircle.Radius=S.Aim.FOV fovCircle.Visible=S.Aim.On and S.Aim.ShowFOV end
 if crossH and crossV then
  local c=vs/2
  crossH.From=Vector2.new(c.X-8,c.Y) crossH.To=Vector2.new(c.X+8,c.Y) crossH.Visible=S.Vis.Cross
  crossV.From=Vector2.new(c.X,c.Y-8) crossV.To=Vector2.new(c.X,c.Y+8) crossV.Visible=S.Vis.Cross
 end
 if S.Vis.FOV then Cam.FieldOfView=S.Vis.FOVVal end
 frames=frames+1 acc=acc+dt
 FL.Visible=S.Misc.FPS
 if acc>=0.5 then
  local f=math.floor(frames/acc+0.5)
  FL.Text="FPS: "..f
  FL.TextColor3=f>=60 and Color3.fromRGB(0,220,0) or f>=30 and Color3.fromRGB(220,200,0) or Color3.fromRGB(220,50,50)
  frames,acc=0,0
 end
end)

-- ===== descarregar =====
local function unload()
 pcall(function() RunService:UnbindFromRenderStep("KH_Main") end)
 for _,c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
 for p in pairs(HBSaved) do hbRestore(p) end
 for _,h in pairs(Chams) do pcall(function() h:Destroy() end) end
 for _,o in ipairs(AllDraw) do killDraw(o) end
 local hum=myHum()
 if hum then pcall(function() hum.PlatformStand=false if origJump then hum.JumpPower=origJump end end) end
 restoreLight("full") restoreLight("fog")
 pcall(function() Root:Destroy() end)
 if getgenv then getgenv().KH_Unload=nil end
end
if getgenv then getgenv().KH_Unload=unload end

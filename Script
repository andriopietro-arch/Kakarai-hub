-- FPS
local FS={}
local function fpsApply(tag,on,roots,classes,prop,val)
 FS[tag]=FS[tag] or {}
 if on then
  for _,rt in ipairs(roots) do
   for _,v in ipairs(rt:GetDescendants()) do
    for _,c in ipairs(classes) do
     if v:IsA(c) then pcall(function() if FS[tag][v]==nil then FS[tag][v]=v[prop] end v[prop]=val end) break end
    end
   end
  end
 else
  for v,o in pairs(FS[tag]) do pcall(function() if v.Parent then v[prop]=o end end) end
  FS[tag]={}
 end
end

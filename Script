local HasDraw=(Drawing~=nil)
local function D(t,props)
 if not HasDraw then return nil end
 local ok,o=pcall(Drawing.new,t)
 if not ok or not o then return nil end
 for k,v in pairs(props or {}) do pcall(function() o[k]=v end) end
 AllDraw[#AllDraw+1]=o
 return o
end
local function killDraw(o) if o then pcall(function() o:Remove() end) end end

local function rootOf(c) return c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso") or c:FindFirstChild("UpperTorso") or c.PrimaryPart end

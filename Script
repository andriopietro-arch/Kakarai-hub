local Tabs,order={},0
local function nx() order=order+1 return order end
local function selectTab(n)
 for name,t in pairs(Tabs) do
  local on=(name==n)
  t.page.Visible=on t.btn.TextColor3=on and RED or MUTED t.ind.Visible=on
  if on then
   t.page.ScrollingEnabled=true
   t.page.CanvasPosition=Vector2.new(0,0)
   t.sync()
   task.defer(t.sync)
  end
 end
end

local function addTab(name)
 local btn=new("TextButton",{Size=UDim2.new(0,70,1,0),BackgroundTransparency=1,Text=name,TextColor3=MUTED,TextSize=11,Font=Enum.Font.GothamBold,LayoutOrder=nx()},TabBar)
 local ind=new("Frame",{Size=UDim2.new(0.7,0,0,2),Position=UDim2.new(0.15,0,1,-2),BackgroundColor3=RED,BorderSizePixel=0,Visible=false},btn)
 local page=new("ScrollingFrame",{Size=UDim2.new(1,0,1,-92),Position=UDim2.new(0,0,0,92),BackgroundTransparency=1,BorderSizePixel=0,Active=true,ScrollBarThickness=3,ScrollBarImageColor3=RED,ScrollingDirection=Enum.ScrollingDirection.Y,AutomaticCanvasSize=Enum.AutomaticSize.None,CanvasSize=UDim2.new(0,0,0,0),Visible=false},Win)
 new("UIPadding",{PaddingLeft=UDim.new(0,10),PaddingRight=UDim.new(0,10),PaddingTop=UDim.new(0,6),PaddingBottom=UDim.new(0,24)},page)
 local lay=new("UIListLayout",{SortOrder=Enum.SortOrder.LayoutOrder,Padding=UDim.new(0,5)},page)
 local function sync() page.CanvasSize=UDim2.new(0,0,0,lay.AbsoluteContentSize.Y+40) end
 lay:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(sync)
 Tabs[name]={page=page,btn=btn,ind=ind,sync=sync}
 btn.Activated:Connect(function() selectTab(name) end)
 local api={}

 function api.Section(t)
  new("TextLabel",{Size=UDim2.new(1,0,0,22),BackgroundTransparency=1,Text="> "..string.upper(t),TextColor3=RED,TextSize=10,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Left,LayoutOrder=nx()},page)
 end
 function api.Note(t)
  local l=new("TextLabel",{Size=UDim2.new(1,0,0,40),BackgroundColor3=BG1,BorderSizePixel=0,Text=t,TextColor3=MUTED,TextSize=11,Font=Enum.Font.Gotham,TextWrapped=true,LayoutOrder=nx()},page)
  corner(l)
 end
 function api.Toggle(label,tbl,key,cb)
  local r=new("TextButton",{Size=UDim2.new(1,0,0,42),BackgroundColor3=BG1,BorderSizePixel=0,Text="",AutoButtonColor=false,LayoutOrder=nx()},page)
  corner(r)
  new("TextLabel",{Size=UDim2.new(1,-72,1,0),Position=UDim2.new(0,12,0,0),BackgroundTransparency=1,Text=label,TextColor3=T1,TextSize=13,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left},r)
  local pill=new("Frame",{Size=UDim2.new(0,46,0,22),Position=UDim2.new(1,-56,0.5,-11),BorderSizePixel=0},r)
  corner(pill,11)
  local knob=new("Frame",{Size=UDim2.new(0,16,0,16),BackgroundColor3=Color3.fromRGB(240,240,245),BorderSizePixel=0},pill)
  corner(knob,8)
  local function paint()
   local on=tbl[key]
   pill.BackgroundColor3=on and RED or Color3.fromRGB(42,42,58)
   knob.Position=on and UDim2.new(1,-19,0.5,-8) or UDim2.new(0,3,0.5,-8)
  end
  paint()
  r.Activated:Connect(function() tbl[key]=not tbl[key] paint() if cb then pcall(cb,tbl[key]) end end)
 end
 function api.Slider(label,tbl,key,mn,mx,step,cb)
  step=step or 1
  local f=new("Frame",{Size=UDim2.new(1,0,0,56),BackgroundColor3=BG1,BorderSizePixel=0,LayoutOrder=nx()},page)
  corner(f)
  local function fmt(v) return step>=1 and tostring(math.floor(v+0.5)) or string.format("%.2f",v) end
  new("TextLabel",{Size=UDim2.new(0.65,0,0,22),Position=UDim2.new(0,12,0,5),BackgroundTransparency=1,Text=label,TextColor3=T1,TextSize=12,Font=Enum.Font.Gotham,TextXAlignment=Enum.TextXAlignment.Left},f)
  local val=new("TextLabel",{Size=UDim2.new(0.3,0,0,22),Position=UDim2.new(0.67,0,0,5),BackgroundTransparency=1,Text=fmt(tbl[key]),TextColor3=RED,TextSize=12,Font=Enum.Font.GothamBold,TextXAlignment=Enum.TextXAlignment.Right},f)
  local tr=new("TextButton",{Size=UDim2.new(1,-24,0,10),Position=UDim2.new(0,12,0,38),BackgroundColor3=Color3.fromRGB(32,32,48),Text="",AutoButtonColor=false,BorderSizePixel=0},f)
  corner(tr,5)
  local fill=new("Frame",{Size=UDim2.new((tbl[key]-mn)/(mx-mn),0,1,0),BackgroundColor3=RED,BorderSizePixel=0},tr)
  corner(fill,5)
  local function setX(x)
   local a=math.clamp((x-tr.AbsolutePosition.X)/math.max(tr.AbsoluteSize.X,1),0,1)
   local v=math.clamp(math.floor((mn+(mx-mn)*a)/step+0.5)*step,mn,mx)
   tbl[key]=v fill.Size=UDim2.new((v-mn)/(mx-mn),0,1,0) val.Text=fmt(v)
   if cb then pcall(cb,v) end
  end
  local drag=false
  tr.InputBegan:Connect(function(i)
   if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=true page.ScrollingEnabled=false setX(i.Position.X) end
  end)
  track(UIS.InputChanged:Connect(function(i)
   if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then setX(i.Position.X) end
  end))
  track(UIS.InputEnded:Connect(function(i)
   if drag and (i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch) then drag=false page.ScrollingEnabled=true end
  end))
 end
 function api.Cycle(label,tbl,key,opts,cb)
  local b=new("TextButton",{Size=UDim2.new(1,0,0,40),BackgroundColor3=BG2,BorderSizePixel=0,TextColor3=T1,TextSize=12,Font=Enum.Font.GothamBold,LayoutOrder=nx()},page)
  corner(b)
  local function paint() b.Text=label..":  "..tostring(tbl[key]).."  >" end
  paint()
  b.Activated:Connect(function()
   local idx=1
   for i,o in ipairs(opts) do if o==tbl[key] then idx=i break end end
   tbl[key]=opts[idx%#opts+1]
   paint()
   if cb then pcall(cb,tbl[key]) end
  end)
 end
 function api.PlayerCycle(label,tbl,key)
  local b=new("TextButton",{Size=UDim2.new(1,0,0,40),BackgroundColor3=BG2,BorderSizePixel=0,TextColor3=T1,TextSize=12,Font=Enum.Font.GothamBold,LayoutOrder=nx(),Text=label..":  Todos  >"},page)
  corner(b)
  b.Activated:Connect(function()
   local list={false}
   for _,p in ipairs(Players:GetPlayers()) do if p~=LP then list[#list+1]=p end end
   local idx=1
   for i,p in ipairs(list) do if p==tbl[key] then idx=i break end end
   local nxt=list[idx%#list+1]
   tbl[key]=nxt or nil
   b.Text=label..":  "..(nxt and nxt.Name or "Todos").."  >"
  end)
 end
 function api.Button(label,fn,col)
  local b=new("TextButton",{Size=UDim2.new(1,0,0,40),BackgroundColor3=col or RED,BorderSizePixel=0,Text=label,TextColor3=Color3.new(1,1,1),TextSize=13,Font=Enum.Font.GothamBold,LayoutOrder=nx()},page)
  corner(b)
  b.Activated:Connect(function() pcall(fn) end)
 end
 return api
end


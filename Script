local function refresh()
 table.clear(Ents)
 for _,p in ipairs(Players:GetPlayers()) do
  if p~=LP and p.Character then
   local c=p.Character
   local h=c:FindFirstChildOfClass("Humanoid")
   local r=rootOf(c)
   if h and r and h.Health>0 then Ents[#Ents+1]={char=c,hum=h,root=r,name=p.DisplayName,player=p} end
  end
 end
 for m,h in pairs(Bots) do
  if not m.Parent then Bots[m]=nil
  elseif m~=LP.Character and not Players:GetPlayerFromCharacter(m) then
   local r=rootOf(m)
   if r and h.Health>0 then Ents[#Ents+1]={char=m,hum=h,root=r,name=m.Name,bot=true} end
  end
 end
end

local function visible(part,char)
 local pr=RaycastParams.new()
 pr.FilterType=Enum.RaycastFilterType.Exclude
 pr.FilterDescendantsInstances={LP.Character,char}
 pr.IgnoreWater=true
 local o=Cam.CFrame.Position
 return workspace:Raycast(o,part.Position-o,pr)==nil
end

-- ===== AIMBOT =====
local currentChar
local function aimPart(e,mode,center)
 local c=e.char
 if mode=="Cabeça" then return c:FindFirstChild("Head") or e.root end
 if mode=="Torso" then return c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso") or e.root end
 if mode=="Raiz" then return e.root end
 local best,bd
 for _,n in ipairs({"Head","UpperTorso","Torso","HumanoidRootPart"}) do
  local p=c:FindFirstChild(n)
  if p then
   local sp,on=Cam:WorldToViewportPoint(p.Position)
   if on then
    local d=(Vector2.new(sp.X,sp.Y)-center).Magnitude
    if not bd or d<bd then bd=d best=p end
   end
  end
 end
 return best
end

local function pickTarget()
 local center=Cam.ViewportSize/2
 local lr=myRoot()
 local bestPart,bestScore,bestE,bestD
 for _,e in ipairs(Ents) do
  if (not e.bot or S.Aim.Bots) and not isTeam(e) and not (S.Aim.Selected and e.player~=S.Aim.Selected) then
   if not (lr and (e.root.Position-lr.Position).Magnitude>S.Aim.MaxDist) then
    local part=aimPart(e,S.Aim.Part,center)
    if part then
     local sp,on=Cam:WorldToViewportPoint(part.Position)
     if on then
      local d=(Vector2.new(sp.X,sp.Y)-center).Magnitude
      local sticky=S.Aim.Sticky and e.char==currentChar
      if (d<=S.Aim.FOV or (sticky and d<=S.Aim.FOV*1.6)) and (not S.Aim.Wall or visible(part,e.char)) then
       local score=sticky and -1 or d
       if not bestScore or score<bestScore then bestScore=score bestPart=part bestE=e bestD=d end
      end
     end
    end
   end
  end
 end
 return bestPart,bestE,bestD
end

local lastClick=0
local function doAim()
 if not S.Aim.On then currentChar=nil return end
 if S.Aim.Hold and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then currentChar=nil return end
 local part,e,d=pickTarget()
 if not part then currentChar=nil return end
 currentChar=e.char
 local pos=part.Position+(e.root.AssemblyLinearVelocity*S.Aim.Pred)
 local goal=CFrame.lookAt(Cam.CFrame.Position,pos)
 Cam.CFrame=Cam.CFrame:Lerp(goal,math.clamp(S.Aim.Smooth,0.01,1))
 if S.Aim.Trig and mouse1click and d<14 and os.clock()-lastClick>0.12 then
  lastClick=os.clock() pcall(mouse1click)
 end
end


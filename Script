local ESPObjs,Chams={},{}
local R15={{"Head","UpperTorso"},{"UpperTorso","LowerTorso"},{"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},{"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},{"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},{"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"}}
local R6={{"Head","Torso"},{"Torso","Left Arm"},{"Torso","Right Arm"},{"Torso","Left Leg"},{"Torso","Right Leg"}}

local function makeESP()
 local o={corners={},skel={}}
 o.box=D("Square",{Thickness=1.5,Filled=false})
 for i=1,8 do o.corners[i]=D("Line",{Thickness=1.6}) end
 o.name=D("Text",{Size=13,Center=true,Outline=true,Color=Color3.new(1,1,1)})
 o.dist=D("Text",{Size=12,Center=true,Outline=true,Color=Color3.fromRGB(200,200,200)})
 o.tracer=D("Line",{Thickness=1.2})
 o.hpbg=D("Square",{Filled=true,Color=Color3.fromRGB(10,10,10)})
 o.hp=D("Square",{Filled=true})
 o.dot=D("Circle",{Thickness=1.5,NumSides=20,Filled=false})
 for i=1,14 do o.skel[i]=D("Line",{Thickness=1.2}) end
 return o
end
local function hideESP(o)
 for _,k in ipairs({"box","name","dist","tracer","hpbg","hp","dot"}) do if o[k] then o[k].Visible=false end end
 for _,l in ipairs(o.corners) do if l then l.Visible=false end end
 for _,l in ipairs(o.skel) do if l then l.Visible=false end end
end
local function removeESP(o)
 for _,k in ipairs({"box","name","dist","tracer","hpbg","hp","dot"}) do killDraw(o[k]) end
 for _,l in ipairs(o.corners) do killDraw(l) end
 for _,l in ipairs(o.skel) do killDraw(l) end
end

local GuiRoot
local function setCham(e,on,color)
 local h=Chams[e.char]
 if on then
  if not h or not h.Parent then
   h=Instance.new("Highlight")
   h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
   h.FillTransparency=0.55 h.OutlineTransparency=0
   h.Adornee=e.char h.Parent=GuiRoot
   Chams[e.char]=h
  end
  h.FillColor=color h.OutlineColor=color
 elseif h then h:Destroy() Chams[e.char]=nil end
end

local function drawESP(e,o)
 local E=S.ESP
 local r=e.root
 local head=e.char:FindFirstChild("Head")
 local top=Cam:WorldToViewportPoint((head and head.Position or r.Position+Vector3.new(0,2,0))+Vector3.new(0,0.8,0))
 local bot=Cam:WorldToViewportPoint(r.Position-Vector3.new(0,3.2,0))
 if top.Z<=0 or bot.Z<=0 then hideESP(o) return end
 local h=math.max(bot.Y-top.Y,8)
 local w=h*0.55
 local cx=(top.X+bot.X)/2
 local x,y=cx-w/2,top.Y
 local col=e.bot and Color3.fromRGB(255,165,0) or Color3.fromRGB(220,30,30)
 if E.VisCol then
  local part=head or r
  col=visible(part,e.char) and Color3.fromRGB(60,230,60) or Color3.fromRGB(230,40,40)
 end

 if o.box then o.box.Visible=false end
 for _,l in ipairs(o.corners) do if l then l.Visible=false end end
 if E.Box=="Caixa" and o.box then
  o.box.Position=Vector2.new(x,y) o.box.Size=Vector2.new(w,h) o.box.Color=col o.box.Visible=true
 elseif E.Box=="Canto" then
  local cl=math.min(w,h)*0.3
  local pts={
   {x,y,x+cl,y},{x,y,x,y+cl},{x+w,y,x+w-cl,y},{x+w,y,x+w,y+cl},
   {x,y+h,x+cl,y+h},{x,y+h,x,y+h-cl},{x+w,y+h,x+w-cl,y+h},{x+w,y+h,x+w,y+h-cl}}
  for i,p in ipairs(pts) do
   local l=o.corners[i]
   if l then l.From=Vector2.new(p[1],p[2]) l.To=Vector2.new(p[3],p[4]) l.Color=col l.Visible=true end
  end
 end

 if o.name then
  o.name.Visible=E.Names
  if E.Names then o.name.Text=(e.bot and "[BOT] " or "")..e.name o.name.Position=Vector2.new(cx,y-16) end
 end
 if o.dist then
  o.dist.Visible=E.Dist
  if E.Dist then
   local lr=myRoot()
   local dv=lr and math.floor((r.Position-lr.Position).Magnitude) or 0
   o.dist.Text="["..dv.."m]" o.dist.Position=Vector2.new(cx,y+h+2)
  end
 end
 if o.hp and o.hpbg then
  o.hp.Visible=E.HP o.hpbg.Visible=E.HP
  if E.HP then
   local ratio=math.clamp(e.hum.Health/math.max(e.hum.MaxHealth,1),0,1)
   o.hpbg.Position=Vector2.new(x-7,y-1) o.hpbg.Size=Vector2.new(5,h+2)
   o.hp.Position=Vector2.new(x-6,y+h*(1-ratio)) o.hp.Size=Vector2.new(3,math.max(h*ratio,1))
   o.hp.Color=Color3.fromRGB(math.floor(255*(1-ratio)),math.floor(230*ratio),30)
  end
 end
 if o.tracer then
  o.tracer.Visible=E.Tracer
  if E.Tracer then
   local vs=Cam.ViewportSize
   local from=E.TracerFrom=="Cima" and Vector2.new(vs.X/2,0) or E.TracerFrom=="Centro" and vs/2 or Vector2.new(vs.X/2,vs.Y)
   o.tracer.From=from o.tracer.To=Vector2.new(cx,y+h) o.tracer.Color=col
  end
 end
 if o.dot then
  o.dot.Visible=false
  if E.Head and head then
   local hs=Cam:WorldToViewportPoint(head.Position)
   if hs.Z>0 then o.dot.Position=Vector2.new(hs.X,hs.Y) o.dot.Radius=math.max(w*0.13,3) o.dot.Color=col o.dot.Visible=true end
  end
 end
 for _,l in ipairs(o.skel) do if l then l.Visible=false end end
 if E.Skel then
  local set=e.char:FindFirstChild("UpperTorso") and R15 or R6
  for i,pair in ipairs(set) do
   local a,b=e.char:FindFirstChild(pair[1]),e.char:FindFirstChild(pair[2])
   local l=o.skel[i]
   if a and b and l then
    local pa,pb=Cam:WorldToViewportPoint(a.Position),Cam:WorldToViewportPoint(b.Position)
    if pa.Z>0 and pb.Z>0 then
     l.From=Vector2.new(pa.X,pa.Y) l.To=Vector2.new(pb.X,pb.Y) l.Color=col l.Visible=true
    end
   end
  end
 end
end

local function updateESP()
 local seen={}
 local lr=myRoot()
 if S.ESP.On then
  for _,e in ipairs(Ents) do
   if (not e.bot or S.ESP.Bots) and not isTeam(e) and not (lr and (e.root.Position-lr.Position).Magnitude>S.G.MaxDist) then
    seen[e.char]=true
    if HasDraw then
     local o=ESPObjs[e.char]
     if not o then o=makeESP() ESPObjs[e.char]=o end
     drawESP(e,o)
    end
    setCham(e,S.ESP.Chams,e.bot and Color3.fromRGB(255,165,0) or Color3.fromRGB(220,30,30))
   end
  end
 end
 for c,o in pairs(ESPObjs) do if not seen[c] then removeESP(o) ESPObjs[c]=nil end end
 for c,h in pairs(Chams) do if not seen[c] or not S.ESP.Chams then h:Destroy() Chams[c]=nil end end
end

-- ===== HITBOX (cubo, sem travar) =====
local HBSaved={}
local function hbPart(e)
 local c=e.char
 if S.HB.Part=="Cabeça" then return c:FindFirstChild("Head") end
 if S.HB.Part=="Torso" then return c:FindFirstChild("UpperTorso") or c:FindFirstChild("Torso") end
 return e.root
end
local function hbRestore(p)
 local s=HBSaved[p]
 if not s then return end
 HBSaved[p]=nil
 pcall(function()
  if p.Parent then p.Size=s.Size p.CanCollide=s.CanCollide p.Massless=s.Massless p.Transparency=s.Transparency p.Material=s.Material p.Color=s.Color end
 end)
end
local function updateHB()
 local active={}
 if S.HB.On then
  local n=S.HB.Size
  for _,e in ipairs(Ents) do
   if (not e.bot or S.HB.Bots) and not isTeam(e) then
    local p=hbPart(e)
    if p and p:IsA("BasePart") then
     active[p]=true
     if not HBSaved[p] then HBSaved[p]={Size=p.Size,CanCollide=p.CanCollide,Massless=p.Massless,Transparency=p.Transparency,Material=p.Material,Color=p.Color} end
     pcall(function()
      p.Size=Vector3.new(n,n,n)
      p.CanCollide=false
      p.Massless=true
      if S.HB.Show then
       p.Transparency=S.HB.Transp p.Material=Enum.Material.Neon p.Color=Color3.fromRGB(220,30,30)
      else
       p.Transparency=HBSaved[p].Transparency p.Material=HBSaved[p].Material p.Color=HBSaved[p].Color
      end
     end)
    end
   end
  end
 end
 for p in pairs(HBSaved) do if not active[p] then hbRestore(p) end end
end

-- ===== MOVIMENTO =====
local origJump
local flyOn=false
track(RunService.Heartbeat:Connect(function(dt)
 pcall(updateHB)
 local hum,root=myHum(),myRoot()
 if not hum or not root then return end
 local M=S.Mv
 if M.Speed and hum.MoveDirection.Magnitude>0 and not M.Fly then
  root.CFrame=root.CFrame+hum.MoveDirection*M.SpeedVal*dt
 end
 if M.Fly then
  flyOn=true
  hum.PlatformStand=true
  local md=hum.MoveDirection
  local look=Cam.CFrame.LookVector
  local flat=Vector3.new(look.X,0,look.Z)
  local fwd=flat.Magnitude>0 and md:Dot(flat.Unit) or 0
  local v=md*M.FlyVal+Vector3.new(0,look.Y*fwd*M.FlyVal,0)
  if UIS:IsKeyDown(Enum.KeyCode.Space) then v=v+Vector3.new(0,M.FlyVal,0) end
  if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.LeftShift) then v=v-Vector3.new(0,M.FlyVal,0) end
  root.AssemblyLinearVelocity=v
 elseif flyOn then flyOn=false hum.PlatformStand=false end
 if M.Jump then
  origJump=origJump or hum.JumpPower
  hum.UseJumpPower=true hum.JumpPower=M.JumpVal
 elseif origJump then hum.JumpPower=origJump origJump=nil end
 if M.Bhop and hum.MoveDirection.Magnitude>0 and hum.FloorMaterial~=Enum.Material.Air then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
 if S.Vis.Full then Lighting.Brightness=2 Lighting.ClockTime=14 Lighting.GlobalShadows=false Lighting.Ambient=Color3.new(1,1,1) Lighting.OutdoorAmbient=Color3.new(1,1,1) end
 if S.Vis.NoFog then Lighting.FogEnd=1e9 end
end))
track(RunService.Stepped:Connect(function()
 if S.Mv.Noclip and LP.Character then
  for _,p in ipairs(LP.Character:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide=false end end
 end
end))
track(UIS.JumpRequest:Connect(function()
 if S.Mv.InfJump then local h=myHum() if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end end
end))
track(LP.Idled:Connect(function()
 if S.Misc.AFK then VirtualUser:CaptureController() VirtualUser:ClickButton2(Vector2.new()) end
end))

